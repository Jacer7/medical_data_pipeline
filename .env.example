# =============================================================================
# MEDICAL DATA PIPELINE ENVIRONMENT CONFIGURATION - EXAMPLE
# =============================================================================
# Copy this file to .env and fill in your actual values
# WARNING: Never commit .env file to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=postgres
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST_AUTH_METHOD=trust

# Database connection for applications
DB_HOST=postgres
DB_PORT=5432
DB_NAME=medical_data
DB_USER=your_username
DB_PASSWORD=your_secure_password

# =============================================================================
# DAGSTER CONFIGURATION
# =============================================================================
DAGSTER_HOME=/opt/dagster/dagster_home
DAGSTER_POSTGRES_USER=your_username
DAGSTER_POSTGRES_PASSWORD=your_secure_password
DAGSTER_POSTGRES_DB=dagster_backend
DAGSTER_POSTGRES_HOST=postgres
DAGSTER_POSTGRES_PORT=5432

# =============================================================================
# MINIO (S3-COMPATIBLE STORAGE) CONFIGURATION
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_secure_minio_password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# DATA PATHS CONFIGURATION
# =============================================================================
RAW_DATA_PATH=/opt/dagster/data/raw
PROCESSED_DATA_PATH=/opt/dagster/data/processed
MODEL_ARTIFACTS_PATH=/opt/dagster/data/models

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
FLASK_ENV=development
FLASK_DEBUG=1
JUPYTER_ENABLE_LAB=yes
JUPYTER_TOKEN=your_secure_jupyter_token
PYTHONPATH=/app

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Set to 'false' in production for better security
POSTGRES_HOST_AUTH_METHOD=trust